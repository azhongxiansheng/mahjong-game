{
	"folders": [
		{
			"path": "godot",
			"name": "🎮 Godot 游戏客户端"
		},
		{
			"path": "backend",
			"name": "🌐 Go 后端服务器"
		},
		{
			"path": "docs",
			"name": "📚 文档"
		}
	],
	"settings": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"[gdscript]": {
			"editor.defaultFormatter": "geequlim.godot-tools",
			"editor.formatOnSave": true
		},
		"[go]": {
			"editor.defaultFormatter": "golang.go",
			"editor.formatOnSave": true
		},
		"[python]": {
			"editor.defaultFormatter": "ms-python.python",
			"editor.formatOnSave": true
		},
		"[markdown]": {
			"editor.wordWrap": "on",
			"editor.formatOnSave": false
		},
		"files.exclude": {
			"**/.godot": true,
			"**/node_modules": true,
			"**/__pycache__": true,
			"**/vendor": true
		},
		"search.exclude": {
			"**/.godot": true,
			"**/node_modules": true,
			"**/vendor": true
		}
	},
	"extensions": {
		"recommendations": [
			"geequlim.godot-tools",
			"golang.go",
			"ms-python.python",
			"esbenp.prettier-vscode",
			"ms-vscode.makefile-tools"
		]
	}
}

