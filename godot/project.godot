; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MahjongGame"
config/description="自主开发的棋牌游戏项目"
config/version="0.1.0"
run/main_scene="res://ui/run/run_flow.tscn"
config/features=PackedStringArray("4.5")

[autoload]

DT="*res://ui/design_tokens.gd"
GameManager="*res://scripts/game_manager.gd"
TextureExtractor="*res://scripts/texture_extractor.gd"
SaveSystem="*res://meta/save_system.gd"
MetaProgress="*res://meta/meta_progress.gd"
AudioManager="*res://audio/audio_manager.gd"
SettingsManager="*res://meta/settings_manager.gd"
DebugOverlay="*res://meta/debug_overlay.gd"
StatsManager="*res://meta/stats_manager.gd"
Log="*res://meta/log.gd"
SaveToast="*res://meta/save_toast.gd"
DailyQuest="*res://meta/daily_quest.gd"
BattlePass="*res://meta/battle_pass.gd"
ANIMA="*res://addons/anima/core/constants.gd"

[display]

; UI 全部按 1280×800 设计;主窗口默认 1280×800 + canvas_items 拉伸。
; 开 hidpi_allowed:Retina 屏按物理像素渲染,贴图采样高质量不糊。
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/anima/plugin.cfg")

[gui]

theme/custom="res://ui/run_theme.tres"

[debug]

gdscript/warnings/unused_argument=1

[physics]

physics_engine="GodotPhysics2D"

[rendering]

; default_texture_filter:3 = LINEAR_WITH_MIPMAPS。gpt-image-2 生成的写实
; 贴图(牌 272×389、立绘、图标)缩放时用 mipmap + 双线性,不会硬边糊。
; 旧的 NEAREST(=1)是 commit 6090d26 时代为 atlas 切片防色块用的,现已过时。
textures/canvas_textures/default_texture_filter=3
renderer/rendering_mode="forward_plus"
