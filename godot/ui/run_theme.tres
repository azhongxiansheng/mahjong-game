[gd_resource type="Theme" load_steps=10 format=3]

; 麻将王 — 原创高对比暗色 UI 主题（紧张麻将桌气质，非第三方 IP）。
; 设为 project.godot 的 gui/theme/custom，全 run-flow 面板默认换肤：
; 共享面板与基础按钮使用内建 StyleBoxFlat 黑曜薄漆，
; 不再消费旧厚框 PNG。字体为霞鹜文楷(LXGW WenKai, OFL)。
; 各处显式 StyleBox override 仍优先。

[ext_resource type="FontFile" path="res://assets/fonts/LXGWWenKai-Regular.ttf" id="font_wenkai"]
[sub_resource type="StyleBoxFlat" id="SB_btn_normal"]
content_margin_left = 18.0
content_margin_top = 10.0
content_margin_right = 18.0
content_margin_bottom = 10.0
bg_color = Color(0.070588, 0.07451, 0.094118, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.788235, 0.603922, 0.333333, 1)
corner_radius_top_left = 2
corner_radius_top_right = 7
corner_radius_bottom_right = 2
corner_radius_bottom_left = 7
shadow_color = Color(0, 0, 0, 0.28)
shadow_size = 2
shadow_offset = Vector2(0, 1)

[sub_resource type="StyleBoxFlat" id="SB_btn_hover"]
content_margin_left = 18.0
content_margin_top = 10.0
content_margin_right = 18.0
content_margin_bottom = 10.0
bg_color = Color(0.105882, 0.105882, 0.12549, 1)
border_width_left = 1
border_width_top = 2
border_width_right = 2
border_width_bottom = 1
border_color = Color(0.788235, 0.603922, 0.333333, 1)
corner_radius_top_left = 2
corner_radius_top_right = 7
corner_radius_bottom_right = 2
corner_radius_bottom_left = 7
shadow_color = Color(0, 0, 0, 0.38)
shadow_size = 4
shadow_offset = Vector2(0, 2)

[sub_resource type="StyleBoxFlat" id="SB_btn_focus"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 3
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.843137, 0.709804, 0.427451, 1)
corner_radius_top_left = 2
corner_radius_top_right = 7
corner_radius_bottom_right = 2
corner_radius_bottom_left = 7

[sub_resource type="StyleBoxFlat" id="SB_btn_pressed"]
content_margin_left = 18.0
content_margin_top = 12.0
content_margin_right = 18.0
content_margin_bottom = 8.0
bg_color = Color(0.05098, 0.054902, 0.070588, 1)
border_width_left = 1
border_width_right = 1
border_width_bottom = 3
border_color = Color(0.560784, 0.439216, 0.278431, 1)
corner_radius_top_left = 2
corner_radius_top_right = 7
corner_radius_bottom_right = 2
corner_radius_bottom_left = 7

[sub_resource type="StyleBoxFlat" id="SB_btn_disabled"]
content_margin_left = 18.0
content_margin_top = 10.0
content_margin_right = 18.0
content_margin_bottom = 10.0
bg_color = Color(0.043137, 0.047059, 0.062745, 1)
border_width_left = 1
border_width_right = 1
border_color = Color(0.435294, 0.439216, 0.462745, 0.55)
corner_radius_top_left = 2
corner_radius_top_right = 7
corner_radius_bottom_right = 2
corner_radius_bottom_left = 7

[sub_resource type="StyleBoxFlat" id="SB_panel"]
content_margin_left = 24.0
content_margin_top = 24.0
content_margin_right = 24.0
content_margin_bottom = 24.0
bg_color = Color(0.066667, 0.070588, 0.090196, 0.960784)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.560784, 0.439216, 0.278431, 1)
corner_radius_top_left = 3
corner_radius_top_right = 7
corner_radius_bottom_right = 3
corner_radius_bottom_left = 7
shadow_color = Color(0, 0, 0, 0.58)
shadow_size = 3
shadow_offset = Vector2(0, 2)

[sub_resource type="StyleBoxFlat" id="SB_pbar_bg"]
bg_color = Color(0.08, 0.08, 0.09, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.12, 0.13, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="SB_pbar_fill"]
bg_color = Color(0.7, 0.18, 0.18, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[resource]
default_font = ExtResource("font_wenkai")
default_font_size = 18
Button/colors/font_color = Color(0.933333, 0.913725, 0.87451, 1)
Button/colors/font_hover_color = Color(0.933333, 0.913725, 0.87451, 1)
Button/colors/font_focus_color = Color(0.933333, 0.913725, 0.87451, 1)
Button/colors/font_pressed_color = Color(1, 0.941176, 0.909804, 1)
Button/colors/font_disabled_color = Color(0.5, 0.5, 0.52, 1)
Button/font_sizes/font_size = 18
Button/styles/normal = SubResource("SB_btn_normal")
Button/styles/hover = SubResource("SB_btn_hover")
Button/styles/pressed = SubResource("SB_btn_pressed")
Button/styles/disabled = SubResource("SB_btn_disabled")
Button/styles/focus = SubResource("SB_btn_focus")
Label/colors/font_color = Color(0.91, 0.88, 0.81, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0.7)
Label/constants/shadow_offset_x = 1
Label/constants/shadow_offset_y = 1
Panel/styles/panel = SubResource("SB_panel")
PanelContainer/styles/panel = SubResource("SB_panel")
ProgressBar/styles/background = SubResource("SB_pbar_bg")
ProgressBar/styles/fill = SubResource("SB_pbar_fill")
ProgressBar/colors/font_color = Color(0.95, 0.93, 0.86, 1)
