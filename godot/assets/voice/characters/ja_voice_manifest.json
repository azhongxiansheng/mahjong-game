          "event": "ability",
          "index": 2,
          "file": "ability_02.wav",
          "text": "まだ引いていない牌ほど、よく見えるものです。"
        },
        {
          "event": "advantage",
          "index": 1,
          "file": "advantage_01.wav",
          "text": "分岐が減りました。あなたの未来は、もう一本だけ。"
        },
        {
          "event": "advantage",
          "index": 2,
          "file": "advantage_02.wav",
          "text": "次の一手も、その次も、同じ場所へ続いています。"
        },
        {
          "event": "hurt",
          "index": 1,
          "file": "hurt_01.wav",
          "text": "この痛みも見えていました。避けなかっただけです。"
        },
        {
          "event": "hurt",
          "index": 2,
          "file": "hurt_02.wav",
          "text": "未来が揺れましたね。ですが、消えてはいません。"
        },
        {
          "event": "win",
          "index": 1,
          "file": "win_01.wav",
          "text": "ツモ。これは予言ではなく、確認です。"
        },
        {
          "event": "win",
          "index": 2,
          "file": "win_02.wav",
          "text": "結末に追いつきました。ずっと先で待っていましたよ。"
        },
        {
          "event": "result_lose",
          "index": 1,
          "file": "result_lose_01.wav",
          "text": "見えた未来を、選び損ねました。"
        },
        {
          "event": "result_lose",
          "index": 2,
          "file": "result_lose_02.wav",
          "text": "今日は別の分岐でした。次は、正しい道を選びます。"
        }
      ],
      "display_name_zh": "先示",
      "base_path": "res://assets/voice/characters/xian_shi/ja"
    },
    "bao_luo": {
      "reference_id": "cb81a549dc8c4ecfb269e00444f25e32",
      "reference_title": "魅惑の大人女性",
      "clips": [
        {
          "event": "entry",
          "index": 1,
          "file": "entry_01.wav",
          "text": "いらっしゃい。赤い糸で、卓ごと結んであげる。"
        },
        {
          "event": "entry",
          "index": 2,
          "file": "entry_02.wav",
          "text": "近くへどうぞ。逃げるほど、糸は強く締まるから。"
        },
        {
          "event": "ability",
          "index": 1,
          "file": "ability_01.wav",
          "text": "赤い糸が、赤ドラをこちらへ連れてくる。"
        },
        {
          "event": "ability",
          "index": 2,
          "file": "ability_02.wav",
          "text": "ほら、赤が増えた。ドラは私を選ぶの。"
        },
        {
          "event": "advantage",
          "index": 1,
          "file": "advantage_01.wav",
          "text": "もう絡まってる。切る牌まで、私の指先次第。"
        },
        {
          "event": "advantage",
          "index": 2,
          "file": "advantage_02.wav",
          "text": "その焦り、綺麗ね。もっと赤く染めてあげる。"
        },
        {
          "event": "hurt",
          "index": 1,
          "file": "hurt_01.wav",
          "text": "あら、糸を切ったつもり？まだ指に絡んでる。"
        },
        {
          "event": "hurt",
          "index": 2,
          "file": "hurt_02.wav",
          "text": "少し痛いわ。でも、これで結び目が深くなった。"
        },
        {
          "event": "win",
          "index": 1,
          "file": "win_01.wav",
          "text": "ツモ。赤ドラも、あなたの運も、全部いただくわ。"
        },
        {
          "event": "win",
          "index": 2,
          "file": "win_02.wav",
          "text": "結び目は完成。もう、どこにも逃げられない。"
        },
        {
          "event": "result_lose",
          "index": 1,
          "file": "result_lose_01.wav",
          "text": "今日は糸が緩んだだけ。縁は切れていないわ。"
        },
        {
          "event": "result_lose",
          "index": 2,
          "file": "result_lose_02.wav",
          "text": "逃がしてあげる。次は、もっと優しく縛るから。"
        }
      ],
      "display_name_zh": "宝络绯",
      "base_path": "res://assets/voice/characters/bao_luo/ja"
    },
    "lian_yao": {
      "reference_id": "6f5ccc8c93374f7c829915ffe6a1e544",
      "reference_title": "気の強い女性",
      "clips": [
        {
          "event": "entry",
          "index": 1,
          "file": "entry_01.wav",
          "text": "一局ずつ斬る。気づいた時には、十二連だ。"
        },
        {
          "event": "entry",
          "index": 2,
          "file": "entry_02.wav",
          "text": "勝ち筋は一本でいい。私はそれを、途切れさせない。"
        },
        {
          "event": "ability",
          "index": 1,
          "file": "ability_01.wav",
          "text": "一勝目。連斬は、ここから速くなる。"
        },
        {
          "event": "ability",
          "index": 2,
          "file": "ability_02.wav",
          "text": "二勝、三勝。刃はもう止まらない。"
        },
        {
          "event": "advantage",
          "index": 1,
          "file": "advantage_01.wav",
          "text": "連なった勝利は、一本の刃になる。"
        },
        {
          "event": "advantage",
          "index": 2,
          "file": "advantage_02.wav",
          "text": "まだ立つのか。次の一閃で数を増やす。"
        },
        {
          "event": "hurt",
          "index": 1,
          "file": "hurt_01.wav",
          "text": "一度止めた程度で、連斬は終わらない。"
        },
        {
          "event": "hurt",
          "index": 2,
          "file": "hurt_02.wav",
          "text": "その傷は覚えた。次の勝ちに重ねる。"
        },
        {
          "event": "win",
          "index": 1,
          "file": "win_01.wav",
          "text": "ツモ。これでまた一つ、刃が連なった。"
        },
        {
          "event": "win",
          "index": 2,
          "file": "win_02.wav",
          "text": "斬って、重ねて、勝ち続ける。それが私だ。"
        },
        {
          "event": "result_lose",
          "index": 1,
          "file": "result_lose_01.wav",
          "text": "連なりは切れた。なら、一から斬り直す。"
        },
        {
          "event": "result_lose",
          "index": 2,
          "file": "result_lose_02.wav",
          "text": "敗北は区切りだ。終わりではない。"
        }
      ],
      "display_name_zh": "连曜真",
      "base_path": "res://assets/voice/characters/lian_yao/ja"
    },
    "ju_jin": {
      "reference_id": "9600581739c44a9c8bd1401faae802ae",
      "reference_title": "日本人渋い声の男性",
      "clips": [
        {
          "event": "entry",
          "index": 1,
          "file": "entry_01.wav",
          "text": "席につけ。勝負は積み重ねで決まる。"
        },
        {
          "event": "entry",
          "index": 2,
          "file": "entry_02.wav",
          "text": "一局の軽さで、私の階段を測るな。"
        },
        {
          "event": "ability",
          "index": 1,
          "file": "ability_01.wav",
          "text": "一段目。勝つたび、私の打点は昇る。"
        },
        {
          "event": "ability",
          "index": 2,
          "file": "ability_02.wav",
          "text": "二段、三段。階はまだ上だ。"
        },
        {
          "event": "advantage",
          "index": 1,
          "file": "advantage_01.wav",
          "text": "足元を見ろ。もう、私の階下にいる。"
        },
        {
          "event": "advantage",
          "index": 2,
          "file": "advantage_02.wav",
          "text": "積み上げた差は、一手では崩れん。"
        },
        {
          "event": "hurt",
          "index": 1,
          "file": "hurt_01.wav",
          "text": "一段落ちただけだ。また昇ればいい。"
        },
        {
          "event": "hurt",
          "index": 2,
          "file": "hurt_02.wav",
          "text": "その一撃は認めよう。だが、頂には届かん。"
        },
        {
          "event": "win",
          "index": 1,
          "file": "win_01.wav",
          "text": "ツモ。これでまた一段、頂へ近づいた。"
        },
        {
          "event": "win",
          "index": 2,
          "file": "win_02.wav",
          "text": "積み重ねた者だけが、最後に卓を見下ろす。"
        },
        {
          "event": "result_lose",
          "index": 1,
          "file": "result_lose_01.wav",
          "text": "今日は段を譲る。階段そのものは残っている。"
        },
        {
          "event": "result_lose",
          "index": 2,
          "file": "result_lose_02.wav",
          "text": "敗北も土台だ。次は、その上から始める。"
        }
      ],
      "display_name_zh": "局进吾",
      "base_path": "res://assets/voice/characters/ju_jin/ja"
    }
  }
}
