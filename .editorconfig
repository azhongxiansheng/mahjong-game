# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# GDScript files
[*.gd]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Go files
[*.go]
indent_style = tab
trim_trailing_whitespace = true
insert_final_newline = true

# Python files
[*.py]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# All files
[*]
charset = utf-8
end_of_line = lf
