# #255/#256 E7 测试拓扑示例环境变量（仅 dev-only 占位；勿填入真实生产密钥）。
# 复制为 .env 后由 docker-compose 注入；.env 默认不入库。

# HMAC 签名密钥，长度 >= 32。本地示例仅供 smoke，不可用于公网。
TOKEN_SIGNING_SECRET=dev-only-example-secret-32bytes!

# #256 Worker 内部注册/续租 token（独立必填；禁止与 TOKEN_SIGNING_SECRET 相同）。
WORKER_REGISTRATION_TOKEN=dev-only-worker-reg-token!

# 可选：Worker 租约/回收（安全默认 15s / 1000ms）。
# WORKER_LEASE_TTL_SEC=15
# WORKER_REAP_INTERVAL_MS=1000
# WORKER_RENEW_INTERVAL_MS=5000

# 双 Worker 宿主可达端点与容量（匹配结果来自注册，而非静态 WORKER_ENDPOINT）。
WORKER_A_ID=e7-worker-a
WORKER_A_GAME_ENDPOINT=ws://127.0.0.1:9000
WORKER_A_VOICE_ENDPOINT=ws://127.0.0.1:9001
WORKER_A_CAPACITY=2
WORKER_B_ID=e7-worker-b
WORKER_B_GAME_ENDPOINT=ws://127.0.0.1:9002
WORKER_B_VOICE_ENDPOINT=ws://127.0.0.1:9003
WORKER_B_CAPACITY=2

# 可选遗留静态端点（不再驱动匹配权威路径）。
# WORKER_ENDPOINT=
# VOICE_WORKER_ENDPOINT=

# 可选：覆盖 STT 模型契约（默认 small + cpu + int8）。
# STT_MODEL=small
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8

# 可选：#248 new-api 备份（缺省禁用；token 禁止写入仓库/镜像/日志）。
# STT_NEW_API_ENDPOINT=
# STT_NEW_API_MODEL=
# STT_NEW_API_TOKEN=
